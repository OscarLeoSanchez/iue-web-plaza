@model Pedido
@{
    ViewData["Title"] = "Pedido confirmado";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card success-card text-center">
                <div class="card-body p-4 p-md-5">
                    <div class="success-icon mb-4">
                        <i class="bi bi-check2"></i>
                    </div>
                    <p class="text-uppercase text-plaza fw-bold small mb-2">Pedido confirmado</p>
                    <h1 class="h2 mb-3">¡Gracias, @Model.Cliente!</h1>
                    <p class="text-secondary fs-5 mb-4">
                        Tu pedido <strong>#@Model.Id</strong> quedó registrado:
                        <strong>@Model.Cantidad</strong> unidad@(Model.Cantidad == 1 ? "" : "es") de
                        <strong>@Model.Producto</strong>.
                    </p>
                    <a asp-action="Listar" class="btn btn-plaza px-4 py-2">
                        <i class="bi bi-grid me-2"></i> Volver al catálogo
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>